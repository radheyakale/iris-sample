# Copy to .env. .env is gitignored. These values are local defaults
# for docker-compose, not production credentials.

POSTGRES_DB=nrw_dc_bi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host port is 5433, matching docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/nrw_dc_bi
